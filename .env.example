# ⚠️ `NEXT_PUBLIC_` PREFIKSI MAJBURIY: bu qiymat BRAUZERGA tushadi
# (panel serverga mijozdan murojaat qiladi). Prefikssiz o'zgaruvchi
# faqat server komponentlarida ko'rinadi va mijozda `undefined`
# bo'lib qolardi — xato esa faqat brauzer konsolida chiqardi.
#
# ⚠️ SHU SABABLI BU YERGA SIR YOZILMAYDI. API kalitlari va JWT
# sirlari — SERVERDA (`server/.env`).
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
